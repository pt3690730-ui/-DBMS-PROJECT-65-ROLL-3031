# ---------------------------------------------------------------------------
#  Galaxy Cinemas - environment template.  Copy to .env and fill in the values.
#  .env is git-ignored: never commit a real connection string or password.
# ---------------------------------------------------------------------------

# Supabase PostgreSQL connection string (Project Settings -> Database -> URI).
# Direct connection (port 5432) is what this project uses:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The transaction pooler (port 6543) also works, but psycopg2 then needs
#   ?sslmode=require&options=-csearch_path%3Dpublic
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# TLS is enforced by the backend; keep "require" for Supabase.
DATABASE_SSLMODE=require

# Flask dev server.
PORT=5000
FLASK_DEBUG=0

# Fixed clock.  Set it to pin "now" so every time-dependent rule (booking window,
# cancellation tiers, refund percentages) is deterministic during the viva.
# Leave it empty to use the real clock.
# CINEMA_NOW=2026-06-15 12:00

# Optional: schema the backend talks to. Defaults to public.
# CINEMA_SCHEMA=public
